    {"id": "lake", "src": "preset:water", "at": [0, 22, 0.02], "params": {"width": 160, "depth": 26}, "mask": false},
    {"id": "rocks", "src": "preset:rocks", "at": [2.4, 4.2, 0], "params": {"count": 3, "spread": 1.2, "size": 0.9, "seed": 5}},
