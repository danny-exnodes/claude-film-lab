{
  "version": 1,
  "title": "Lookbook: every preset in one static frame",
  "note": "tools/blender/blender.py lookbook renders the middle frame of this shot once per look.",
  "size": [1920, 1080], "fps": 24, "seconds": 2, "seed": 3,
  "look": "ink-wash", "engine": "eevee",
  "world": {"mist": 0.8, "mist_range": [8, 140], "sun": [34, 290]},
