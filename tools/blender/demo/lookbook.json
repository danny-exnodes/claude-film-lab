    {"id": "cube", "src": "prim:cube", "at": [-2.4, 4.0, 0.35], "rot": [0, 0, 30], "scale": 0.7, "color": "#B02E22"},
    {"id": "giot", "src": "preset:giot", "at": [-0.6, 3.2, 0], "rot": [0, 0, 12], "anim": {"action": "wave"}}
