{
  "id": "h3-r2v",
  "title": "MiniMax H3 reference-to-video with audio: 1-9 reference images, optional time anchors",
  "source": "Comfy-Org workflow_templates video_minimax_h3_r2v.json and video_minimax_h3_multiframe_reference.json (MiniMaxH3AddGuide chain), API format; node classes, input names and wiring from the templates, values ours",
  "verified": false,
  "model_set": "minimax-h3",
  "fps": 24,
  "frames": {"grid": [17, 5], "min": 5, "max": 362, "trained": [124, 362]},
  "size_multiple": 32,
  "res": {"480p": [864, 480], "768p": [1344, 768]},
  "defaults": {"seconds": 5, "res": "768p", "steps": 20},
  "turbo": {"steps": 4, "note": "Lightning/Turbo LoRA: drafts only, never for faces or quality runs"},
  "negative": false,
  "prompt_format": "r2v",
  "images": {},
  "params": {
    "prompt": [["8", "prompt"]],
    "width": [["8", "width"]],
    "height": [["8", "height"]],
    "frames": [["8", "length"]],
    "ref_size": [["8", "ref_image_size"]],
    "seed": [["9", "noise_seed"]],
    "steps": [["11", "steps"]],
    "fps": [["16", "fps"]],
    "prefix": [["17", "filename_prefix"]]
  },
  "optional": {
    "turbo": {"remove": ["2"], "rewire": [["11", "model", "1", 0], ["12", "model", "1", 0]]}
  },
  "refs": {"node": "8", "prefix": "ref_images.ref_image_", "first": 0, "min": 1, "max": 9, "ids_from": 100},
  "guides": {"positive": ["8", 0], "latent": ["8", 1], "vae": ["4", 0], "audio_vae": ["5", 0],
             "consumer": ["12", "conditioning"], "max": 8, "ids_from": 200},
  "output": {"node": "17"}
}
